# Local WSL canonical file: /root/.config/discord-bot/runtime.env (0700/0600).
# Process environment wins; DISCORD_BOT_ENV_FILE may override the path explicitly.
DISCORD_BOT_ENV_FILE=/root/.config/discord-bot/runtime.env
DISCORD_TOKEN=your_discord_bot_token_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=your_groq_api_key_here
ZHIPU_API_KEY=your_zhipu_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=
# 本地 sidecar 可设为 http://127.0.0.1:8080/v1/video-summary；VPS 由 Compose 固定注入
INFO_CURATOR_SERVICE_URL=
INFO_CURATOR_REQUEST_TIMEOUT_SECONDS=210
# 仅随 Wikipedia API 请求发送，不写入日志或公开设置
BOT_CONTACT_EMAIL=
BOT_TIMEZONE=America/Toronto
LOG_LEVEL=INFO
# 本地默认启用；首次 VPS canary 应设为 false，确认后再开启
BOT_ENABLE_SCHEDULED_JOBS=true
# 可选；部署时将可变 JSON 状态放到代码目录之外，必须使用绝对路径
BOT_STATE_DIR=
